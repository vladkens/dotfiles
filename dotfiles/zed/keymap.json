// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "cmd-d": "editor::DuplicateLineDown",
      "cmd-shift-up": "editor::AddSelectionAbove",
      "cmd-shift-down": "editor::AddSelectionBelow",
      "cmd-shift-l": "editor::Format",
      "cmd-l": "go_to_line::Toggle",
      "cmd-=": "zed::IncreaseBufferFontSize",
      "cmd--": "zed::DecreaseBufferFontSize",
      "cmd-0": "zed::ResetBufferFontSize",
      "ctrl-w": "editor::ToggleSoftWrap",
      "cmd-/": ["workspace::SendKeystrokes", "cmd-/ down"],
      "alt-shift-down": null,
      "alt-shift-f": null,
      "alt-cmd-up": null,
      "alt-cmd-down": null,
      "ctrl-g": null
    }
  }
]
