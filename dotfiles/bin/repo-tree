#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "rich>=13.9",
# ]
# ///
import argparse
import os
import subprocess
from dataclasses import dataclass
from pathlib import Path

from rich.console import Console
from rich.text import Text
from rich.tree import Tree

IGNORED_DIRS = {
    ".cache",  # Program caches usually contain temporary files, not projects.
    ".infracost",  # Infracost stores generated cost-estimation data and modules here.
    ".mypy_cache",  # mypy stores generated type-checking cache here.
    ".pytest_cache",  # pytest stores generated test cache here.
    ".ruff_cache",  # Ruff stores generated lint/format cache here.
    ".terraform",  # Terraform downloads providers and modules here.
    ".tox",  # tox creates virtual test environments here.
    ".venv",  # Python virtual environments contain dependencies, not projects.
    "__pycache__",  # Python bytecode cache is generated by the interpreter.
    "node_modules",  # JavaScript dependencies are large and not your projects.
    "target",  # Rust build output contains compiled artifacts.
    "vendor",  # Vendored dependencies are usually third-party code copies.
}

CONSOLE = Console(highlight=False)
DIRECTORY_STYLE = "bright_blue"
GUIDE_STYLE = "bright_black"
REPOSITORY_STYLE = "bright_green"
ROOT_STYLE = "bold bright_magenta"


@dataclass
class TreeNode:
    name: str
    is_repo: bool
    children: list["TreeNode"]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Print a compact tree of git repositories under a directory."
    )
    parser.add_argument(
        "path",
        nargs="?",
        type=Path,
        default=Path.cwd(),
        help="Directory to scan. Defaults to the current directory.",
    )
    parser.add_argument(
        "--show-ignored",
        action="store_true",
        help="Do not skip common cache, dependency, and build directories.",
    )
    return parser.parse_args()


def find_repositories(
    root: Path,
    show_ignored: bool,
) -> list[Path]:
    command = [
        "fd",
        "--hidden",
        "--glob",
        "--absolute-path",
        "--print0",
        "--prune",
        "--no-ignore",
    ]

    if not show_ignored:
        for directory in sorted(IGNORED_DIRS):
            command.extend(["--exclude", directory])

    command.extend([".git", str(root)])

    try:
        result = subprocess.run(command, capture_output=True, check=False)
    except FileNotFoundError:
        raise SystemExit("fd is required; install it with 'brew install fd'") from None

    if result.returncode != 0:
        message = os.fsdecode(result.stderr).strip() or "fd failed"
        raise SystemExit(message)

    return [Path(os.fsdecode(match)).parent for match in result.stdout.split(b"\0") if match]


def build_tree(root: Path, repositories: list[Path]) -> TreeNode | None:
    if not repositories:
        return None

    tree = TreeNode(name=root.name, is_repo=False, children=[])
    nodes = {root: tree}

    for repository in repositories:
        parent = root
        for part in repository.relative_to(root).parts:
            path = parent / part
            if path not in nodes:
                node = TreeNode(name=part, is_repo=False, children=[])
                nodes[parent].children.append(node)
                nodes[path] = node
            parent = path
        nodes[repository].is_repo = True

    for node in nodes.values():
        node.children.sort(key=lambda child: child.name.casefold())

    return tree


def render_tree(tree: TreeNode, is_root: bool = True) -> Tree:
    if is_root:
        style = ROOT_STYLE
    elif tree.is_repo:
        style = REPOSITORY_STYLE
    else:
        style = DIRECTORY_STYLE

    rendered = Tree(Text(tree.name, style=style), guide_style=GUIDE_STYLE)
    for child in tree.children:
        rendered.add(render_tree(child, is_root=False))
    return rendered


def main() -> None:
    args = parse_args()
    root = args.path.expanduser().resolve()
    if not root.exists():
        raise SystemExit(f"not found: {root}")
    if not root.is_dir():
        raise SystemExit(f"not a directory: {root}")

    repositories = find_repositories(root, args.show_ignored)
    tree = build_tree(root, repositories)
    if tree is None:
        print(f"no git repositories found under {root}")
        return

    tree.name = "." if root == Path.cwd().resolve() else str(root)
    CONSOLE.print(render_tree(tree))


if __name__ == "__main__":
    main()
