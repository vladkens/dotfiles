{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/permission-policy.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/command-rewrite.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "jq -r .session_id > \"${CODEX_SESSION_FILE:-/dev/null}\"",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume)$"
      }
    ]
  }
}
