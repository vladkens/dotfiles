{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/permission-policy.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/hooks/command-rewrite.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ]
  }
}
