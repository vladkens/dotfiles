#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///

import json
from pathlib import Path

from _lib import output, run

PROTECTED_BRANCHES = {"main", "master", "develop"}


def find_git_root() -> Path:
    root = output(["git", "rev-parse", "--show-toplevel"])
    return Path(root).resolve()


def list_branches(git_root: Path) -> list[str]:
    current_branch = output(["git", "branch", "--show-current"], cwd=git_root)
    protected = PROTECTED_BRANCHES | {current_branch}
    branches = output(
        ["git", "branch", "--format=%(refname:short)"],
        cwd=git_root,
    )
    return [branch for branch in branches.splitlines() if branch not in protected]


def list_worktree_branches(git_root: Path) -> dict[str, Path]:
    metadata = output(
        ["git", "worktree", "list", "--porcelain", "-z"],
        cwd=git_root,
    )
    branches = {}
    worktree = None

    for field in metadata.split("\0"):
        if field.startswith("worktree "):
            worktree = Path(field.removeprefix("worktree "))
        elif field.startswith("branch refs/heads/") and worktree is not None:
            branch = field.removeprefix("branch refs/heads/")
            branches[branch] = worktree

    return branches


def find_merged_pr(git_root: Path, branch: str) -> dict[str, object] | None:
    response = output(
        [
            "gh",
            "pr",
            "list",
            "--state",
            "merged",
            "--head",
            branch,
            "--limit",
            "1",
            "--json",
            "number,url",
        ],
        cwd=git_root,
    )
    pull_requests = json.loads(response)
    return pull_requests[0] if pull_requests else None


def main() -> None:
    git_root = find_git_root()
    branches = list_branches(git_root)
    worktree_branches = list_worktree_branches(git_root)
    merged = [
        (branch, pull_request)
        for branch in branches
        if (pull_request := find_merged_pr(git_root, branch)) is not None
    ]

    deleted = 0
    for branch, pull_request in merged:
        if worktree := worktree_branches.get(branch):
            print(f"Removing worktree {worktree} for {branch}")
            run(
                ["git", "worktree", "remove", "--force", str(worktree)],
                cwd=git_root,
            )

        print(f"Deleting {branch} (#{pull_request['number']}) {pull_request['url']}")
        run(["git", "branch", "-D", "--", branch], cwd=git_root)
        deleted += 1

    noun = "branch" if deleted == 1 else "branches"
    print(f"Deleted {deleted} merged PR {noun}.")


if __name__ == "__main__":
    main()
